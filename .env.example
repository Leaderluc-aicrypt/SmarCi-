# ---------------------------------------------------------------------------
# SmarCi — Variables d'environnement
# ---------------------------------------------------------------------------
# Copier ce fichier en `.env.local` et renseigner les valeurs réelles.
#
#   cp .env.example .env.local
#
# `.env.local` n'est JAMAIS commité (voir .gitignore).
# Les mêmes variables doivent être déclarées dans Vercel :
# Project Settings > Environment Variables.
# ---------------------------------------------------------------------------

# --- Supabase (Dashboard > Project Settings > API) -------------------------

# URL publique du projet. Exposée au navigateur : ce n'est pas un secret.
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxxxxxx.supabase.co"

# Clé anonyme (anon / publishable). Exposée au navigateur : ce n'est pas un
# secret. Sa sécurité repose entièrement sur les policies RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# --- Secrets serveur -------------------------------------------------------
# Ces deux valeurs ne doivent JAMAIS être préfixées NEXT_PUBLIC_, ni apparaître
# dans du code client, ni être partagées dans une conversation ou un ticket.

# Clé service_role : CONTOURNE TOUTE LA RLS. Réservée aux tâches
# d'administration côté serveur. Non utilisée en Phase 1 — optionnelle pour
# l'instant.
SUPABASE_SERVICE_ROLE_KEY=""

# Clé API OpenAI. Utilisée à partir de la Phase 4 (intégration IA).
# Optionnelle en Phase 1.
OPENAI_API_KEY=""
